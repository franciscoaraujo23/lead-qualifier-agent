# Copy to .env and adjust. All vars are prefixed LQ_.

# --- LLM ---
LQ_LLM_PROVIDER=mock          # mock | anthropic
LQ_LLM_MODEL=claude-haiku-4-5
# LQ_ANTHROPIC_API_KEY=sk-ant-...

# --- Safety / abuse ceiling (architecture.md §4.7) ---
# LQ_WEBHOOK_AUTH_TOKEN=change-me
LQ_DAILY_COST_CEILING_USD=5.0

# --- Timeouts (§4.8), seconds ---
LQ_ENRICHMENT_TIMEOUT_S=8.0
LQ_LLM_TIMEOUT_S=20.0

# --- Schema repair (§4.2) ---
LQ_SCHEMA_REPAIR_MAX_RETRIES=2

# --- Optional hot-path action (§8). Leave unset to no-op. ---
# LQ_HOT_PATH_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Persistence ---
LQ_DATABASE_URL=postgresql://lq:lq@localhost:5432/lead_qualifier

# --- n8n orchestration (architecture.md §4.2) ---
# Where the n8n workflow reaches the API. Inside compose this is the service
# name; override only if you run the API somewhere else.
LQ_API_URL=http://api:8000
# Transport-retry bound for the n8n -> FastAPI call. Backoff is 2^attempt
# seconds (2s, then 4s), and only 5xx/network failures are retried.
LQ_N8N_MAX_ATTEMPTS=3
